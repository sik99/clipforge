# Remove the line below if you want to inherit .editorconfig settings from higher directories
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,feature}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{cs,ps1,psm1,psd1}]
indent_style = tab

# C# files
[*.cs]

# this. preferences
dotnet_style_qualification_for_event = true:suggestion
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_property = true:suggestion

# Language keywords vs BCL types preferences
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# var preferences
csharp_style_var_elsewhere = true:silent
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent

# Expression-bodied members: prefer expression bodies only on a single line.
csharp_style_expression_bodied_accessors = when_on_single_line:silent
csharp_style_expression_bodied_constructors = when_on_single_line:silent
csharp_style_expression_bodied_indexers = when_on_single_line:silent
csharp_style_expression_bodied_lambdas = when_on_single_line:silent
csharp_style_expression_bodied_local_functions = when_on_single_line:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_operators = when_on_single_line:silent
csharp_style_expression_bodied_properties = when_on_single_line:silent

# Null-checking preferences
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion

# Pattern matching preferences
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Code-block and spacing preferences
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all
csharp_space_after_cast = true
csharp_space_around_binary_operators = before_and_after

# Modifier order: use the C# default.
dotnet_diagnostic.IDE0036.severity = suggestion

# Namespace declarations
csharp_style_namespace_declarations = file_scoped:suggestion

# 'using' directive and statement preferences
csharp_using_directive_placement = outside_namespace:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# Naming styles
dotnet_naming_rule.types_and_members.symbols = types_and_members
dotnet_naming_rule.types_and_members.style = pascal_case
dotnet_naming_rule.types_and_members.severity = suggestion

dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface_prefix
dotnet_naming_rule.interfaces.severity = suggestion

dotnet_naming_rule.variables.symbols = variables
dotnet_naming_rule.variables.style = camel_case
dotnet_naming_rule.variables.severity = suggestion

# More specific visibility and modifier rules override camelCase for fields and locals.
dotnet_naming_rule.exposed_fields.symbols = exposed_fields
dotnet_naming_rule.exposed_fields.style = pascal_case
dotnet_naming_rule.exposed_fields.severity = suggestion

dotnet_naming_rule.private_internal_static_fields.symbols = private_internal_static_fields
dotnet_naming_rule.private_internal_static_fields.style = static_prefix
dotnet_naming_rule.private_internal_static_fields.severity = suggestion

# Private/internal constants override the s_ prefix.
dotnet_naming_rule.private_internal_constants.symbols = private_internal_constants
dotnet_naming_rule.private_internal_constants.style = pascal_case
dotnet_naming_rule.private_internal_constants.severity = suggestion

dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal_case
dotnet_naming_rule.constants.severity = suggestion

dotnet_naming_rule.type_parameters.symbols = type_parameters
dotnet_naming_rule.type_parameters.style = type_parameter_prefix
dotnet_naming_rule.type_parameters.severity = suggestion

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, property, event, method, local_function
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_symbols.variables.applicable_kinds = parameter, local, field
dotnet_naming_symbols.variables.applicable_accessibilities = *
dotnet_naming_symbols.exposed_fields.applicable_kinds = field
dotnet_naming_symbols.exposed_fields.applicable_accessibilities = public, protected, protected_internal, private_protected
dotnet_naming_symbols.private_internal_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_static_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_internal_static_fields.required_modifiers = static
dotnet_naming_symbols.private_internal_constants.applicable_kinds = field
dotnet_naming_symbols.private_internal_constants.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_internal_constants.required_modifiers = const
# Constants include enum members and local constants.
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.static_prefix.capitalization = camel_case
dotnet_naming_style.static_prefix.required_prefix = s_
dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.type_parameter_prefix.capitalization = pascal_case
dotnet_naming_style.type_parameter_prefix.required_prefix = T

# CA2000: Dispose objects before losing scope
dotnet_diagnostic.CA2000.severity = error

# CA2213: Disposable fields should be disposed
dotnet_diagnostic.CA2213.severity = error
